global:
  scrape_interval:     5s
  evaluation_interval: 5s
  
rule_files:
  - "alerts.yml"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'redis_exporter'
    metrics_path: '/metrics'
    basic_auth:
      username: 'REDIS_EXPORTER_BASIC_AUTH_USERNAME'
      password: 'REDIS_EXPORTER_BASIC_AUTH_PASSWORD'
    static_configs:
      - targets: ['localhost:9121']
